{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "startCommandDir": "backend",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120
  }
}

