        "validation_rule",
        "view",
        "webhook",
        "webhook_event",
        "widget",
        "workflow",
        "workflow_step",
        "workflow_transition",
        "workflow_trigger",
        "record"
      ]
    },
    "PayloadMetadata": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentationRef": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
