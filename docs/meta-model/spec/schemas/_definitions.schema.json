{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.mak.platform/mmm/v1/_definitions",
  "title": "MMM shared JSON Schema definitions",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "ObjectRef": {
      "type": "string",
      "minLength": 1,
      "description": "Stable objectId reference"
    },
    "LabelSet": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "helpText": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "locale",
        "label"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "applicationId": {
          "$ref": "#/$defs/ObjectRef"
        },
        "moduleId": {
          "$ref": "#/$defs/ObjectRef"
        },
        "companyId": {
          "$ref": "#/$defs/ObjectRef"
        },
        "ouId": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "additionalProperties": false
    },
    "LineageSource": {
      "type": "string",
      "enum": [
        "studio",
        "business_language",
        "ai",
        "marketplace",
        "import",
        "system"
      ]
    },
    "Lineage": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/LineageSource"
        },
        "sourceRef": {
          "type": "string"
        },
        "parentVersion": {
          "type": "string"
        },
        "templateRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "packageId": {
          "type": "string"
        },
        "intentId": {
          "type": "string"
        },
        "aiCandidateId": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "LifecycleStatus": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "published",
        "active",
        "deprecated",
        "archived",
        "rejected",
        "deleted"
      ]
    },
    "Dependencies": {
      "type": "object",
      "properties": {
        "possess": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "use": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "reference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "depend": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          }
        },
        "inherit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objectId": {
                "$ref": "#/$defs/ObjectRef"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "objectId"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ObjectTypeEnum": {
      "type": "string",
      "description": "227 taxonomy values; see object-type-manifest.json (226 with PlatformSchema)",
      "enum": [
        "access_policy",
        "action",
        "action_bar",
        "action_chain",
        "aggregation",
        "ai_candidate",
        "ai_context",
        "ai_prompt",
        "api",
        "api_endpoint",
        "api_method",
        "api_parameter",
        "api_response",
        "application",
        "application_version",
        "approval_step",
        "attachment",
        "audit_trail_view",
        "automation",
        "base_template",
        "branch_block",
        "business_asset",
        "business_asset_version",
        "business_intent",
        "business_intent_document",
        "business_language",
        "business_object",
        "business_object_definition",
        "business_object_version",
        "business_objective",
        "business_process",
        "business_rule",
        "business_synonym",
        "business_term",
        "button",
        "calculated_column",
        "calendar",
        "calendar_event",
        "capability",
        "capability_group",
        "card",
        "chart",
