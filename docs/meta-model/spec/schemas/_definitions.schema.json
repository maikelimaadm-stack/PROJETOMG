        "constraint",
        "dashboard",
        "dashboard_page",
        "data_category",
        "data_source",
        "decision",
        "definition_version",
        "derivation",
        "derivation_plan",
        "design_token",
        "detail",
        "dialog",
        "document",
        "document_template",
        "drawer",
        "drill_down",
        "entity",
        "entity_kind",
        "environment_pin",
        "event",
        "event_bus_subscription",
        "event_handler",
        "explainability",
        "expression",
        "extension",
        "extension_point",
        "external_data_source",
        "feature",
        "field",
        "field_group",
        "field_option",
        "filter",
        "filter_field",
        "form",
        "formatter",
        "formula",
        "function",
        "gallery",
        "governance_policy",
        "grid",
        "group",
        "health_signal",
        "help_text",
        "home_surface",
        "icon",
        "inbox",
        "index",
        "indicator",
        "industry_pack",
        "insight",
        "integration",
        "integration_flow",
        "integration_mapping",
        "intent_catalog",
        "intent_template",
        "iot_device",
        "iot_stream",
        "iot_trigger",
        "kanban",
        "kanban_card",
        "kanban_column",
        "kanban_swimlane",
        "knowledge_edge",
        "knowledge_node",
        "kpi",
        "label",
