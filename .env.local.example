# Copie para .env.local e ajuste conforme seu ambiente.
# cp .env.local.example .env.local

# Login sem backend (só UI / layout — APIs de dados ainda precisam da API real)
VITE_DEV_AUTH_MOCK=true

# Não use em dev com proxy do Vite (deixe comentado; o proxy já aponta /api → :3001)
# VITE_API_URL=http://localhost:3001

# Modo personalizações locais:
# - desliga sync remoto do layout (localStorage fica só na sua máquina)
# - habilita window.__empPersonalizacoes no console do navegador
VITE_LOCAL_PERSONALIZACOES=true
