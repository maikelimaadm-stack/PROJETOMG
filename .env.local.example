# Copie para .env.local e ajuste conforme seu ambiente.
# cp .env.local.example .env.local

# --- Recomendado: dev com API de produção (mesmo código/UX do makgestao.com) ---

# Entra direto sem tela de login (somente em npm run dev)
VITE_DEV_AUTO_LOGIN=true
VITE_DEV_AUTO_LOGIN_CLIENTE=maike
VITE_DEV_AUTO_LOGIN_USUARIO=maike
VITE_DEV_AUTO_LOGIN_SENHA=123

# Proxy /api → backend remoto (evita CORS em localhost)
VITE_API_PROXY_TARGET=https://projetomg-production.up.railway.app

# Não defina VITE_API_URL em dev — o proxy do Vite já encaminha /api

# --- Alternativas ---

# Login mock (só UI; APIs de dados falham sem token real)
# VITE_DEV_AUTH_MOCK=true

# Personalizações só no localStorage (desliga sync remoto de layout)
# VITE_LOCAL_PERSONALIZACOES=true

# Instrumentação performance.mark para diagnóstico de preferências (somente dev)
# VITE_EMPRESAS_PREFERENCES_PERF=true

# Kill switch P0 — desliga sync avançado v2 de preferências Empresas (cross-tab, flush awaitable, bootstrap generation)
# VITE_EMPRESAS_PREFERENCES_V2_ENABLED=false

# Backend local na porta 3001 (remova VITE_API_PROXY_TARGET se usar)
# cd backend && cp .env.example .env && npm run dev
