{
  "name": "RegistroAnexo",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "Nome da entidade ao qual o anexo pertence"
    },
    "record_id": {
      "type": "string",
      "description": "ID do registro ao qual o anexo pertence"
    },
    "attachment_name": {
      "type": "string",
      "description": "Nome descritivo do arquivo"
    },
    "file_name": {
      "type": "string",
      "description": "Nome original do arquivo"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "file_type": {
      "type": "string",
      "description": "Tipo MIME do arquivo"
    },
    "file_size": {
      "type": "number",
      "description": "Tamanho do arquivo em bytes"
    }
  },
  "required": [
    "entity_name",
    "file_url"
  ]
}