{
  "name": "CampoPersonalizado",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Nome exibido do campo"
    },
    "field_name": {
      "type": "string",
      "description": "Nome interno do campo (snake_case)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "number",
        "date",
        "datetime",
        "time",
        "select",
        "option_list",
        "relation",
        "calculado"
      ],
      "default": "text",
      "description": "Tipo do campo"
    },
    "placeholder": {
      "type": "string",
      "description": "Texto de ajuda"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do campo"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": false
    },
    "read_only": {
      "type": "boolean",
      "default": false
    },
    "visivel_form": {
      "type": "boolean",
      "default": true
    },
    "visivel_tabela": {
      "type": "boolean",
      "default": true
    },
    "visivel_relatorio": {
      "type": "boolean",
      "default": true
    },
    "ordenavel": {
      "type": "boolean",
      "default": true
    },
    "filtravel": {
      "type": "boolean",
      "default": true
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "ordem_tabela": {
      "type": "number",
      "default": 999
    },
    "largura_coluna": {
      "type": "number",
      "default": 160
    },
    "alinhamento": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "agregacao_tipo": {
      "type": "string",
      "description": "Tipo de agrega\u00e7\u00e3o (sum, avg, min, max, count)"
    },
    "options": {
      "type": "array",
      "description": "Op\u00e7\u00f5es para campos do tipo select/option_list"
    },
    "options_text": {
      "type": "string",
      "description": "Op\u00e7\u00f5es em texto separado por linha"
    },
    "options_source_entity": {
      "type": "string",
      "description": "Entidade fonte para op\u00e7\u00f5es din\u00e2micas"
    },
    "options_label_field": {
      "type": "string",
      "default": "nome"
    },
    "options_value_field": {
      "type": "string",
      "default": "id"
    },
    "relation_entity": {
      "type": "string",
      "description": "Entidade relacionada"
    },
    "relation_display_field": {
      "type": "string",
      "default": "nome"
    },
    "formula": {
      "type": "string",
      "description": "F\u00f3rmula para campo calculado"
    },
    "calculation_builder": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o visual do c\u00e1lculo"
    },
    "campos_dependentes": {
      "type": "array",
      "description": "Campos usados no c\u00e1lculo"
    },
    "usar_decimal": {
      "type": "boolean",
      "default": false
    },
    "decimal_places": {
      "type": "number",
      "default": 2
    },
    "usar_mascara": {
      "type": "boolean",
      "default": false
    },
    "mascaras_text": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Metadados adicionais do campo"
    }
  },
  "required": [
    "label",
    "field_name",
    "tipo"
  ]
}