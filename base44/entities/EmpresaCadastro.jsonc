{
  "name": "EmpresaCadastro",
  "type": "object",
  "properties": {
    "codigo_empresa": {
      "type": "number",
      "description": "C\u00f3digo natural incremental permanente (gerado via sequence backend)"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia da empresa"
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "PF",
        "PJ"
      ],
      "default": "PJ",
      "description": "Tipo de pessoa: F\u00edsica ou Jur\u00eddica"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "inscricao_estadual": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o estadual"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logotipo da empresa"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "endereco": {
      "type": "string",
      "description": "Logradouro"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativa",
        "Inativa"
      ],
      "default": "Ativa",
      "description": "Status da empresa"
    },
    "campos_personalizados": {
      "type": "object",
      "description": "Campos personalizados e din\u00e2micos"
    }
  },
  "required": [
    "razao_social",
    "tipo_pessoa"
  ]
}