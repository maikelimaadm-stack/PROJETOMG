{
  "name": "CampoPersonalizadoEmpresa",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Nome do campo"
    },
    "field_name": {
      "type": "string",
      "description": "Identificador interno (snake_case)"
    },
    "placeholder": {
      "type": "string",
      "description": "Texto auxiliar"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do campo"
    },
    "tipo": {
      "type": "string",
      "default": "text",
      "description": "Tipo do campo"
    },
    "col_span": {
      "type": "number",
      "default": 12
    },
    "largura_coluna": {
      "type": "number",
      "default": 160
    },
    "ordem_tabela": {
      "type": "number",
      "default": 999
    },
    "obrigatorio": {
      "type": "boolean",
      "default": false
    },
    "read_only": {
      "type": "boolean",
      "default": false
    },
    "visivel_form": {
      "type": "boolean",
      "default": true
    },
    "visivel_tabela": {
      "type": "boolean",
      "default": true
    },
    "visivel_relatorio": {
      "type": "boolean",
      "default": true
    },
    "ordenavel": {
      "type": "boolean",
      "default": true
    },
    "filtravel": {
      "type": "boolean",
      "default": true
    },
    "alinhamento": {
      "type": "string",
      "default": "left"
    },
    "agregacao_tipo": {
      "type": "string"
    },
    "agregacao_campo_base": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "options_text": {
      "type": "string"
    },
    "options_source_entity": {
      "type": "string"
    },
    "options_label_field": {
      "type": "string",
      "default": "nome"
    },
    "options_value_field": {
      "type": "string",
      "default": "id"
    },
    "relation_entity": {
      "type": "string"
    },
    "relation_display_field": {
      "type": "string",
      "default": "nome"
    },
    "formula": {
      "type": "string"
    },
    "calculation_builder": {
      "type": "object"
    },
    "campos_dependentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usar_decimal": {
      "type": "boolean",
      "default": false
    },
    "decimal_places": {
      "type": "number",
      "default": 2
    },
    "usar_mascara": {
      "type": "boolean",
      "default": false
    },
    "mascaras_text": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label",
    "field_name",
    "tipo"
  ]
}