generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UsuarioPerfil {
  ADMIN
  OPERADOR
  CONSULTA
}

model Cliente {
  id                String    @id @default(cuid())
  codigo            String    @unique @db.VarChar(64)
  nome              String    @db.VarChar(255)
  cpf_cnpj          String?   @db.VarChar(32)
  telefone          String?   @db.VarChar(32)
  email             String?   @db.VarChar(255)
  status            String    @default("Ativo") @db.VarChar(32)
  plano             String?   @db.VarChar(64)
  limite_usuarios   Int?
  limite_empresas   Int?
  data_vencimento   DateTime?
  observacoes       String?
  next_id_global    Int       @default(1)
  total_empresas    Int       @default(0)
  total_cadcps_campos Int     @default(0)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  usuarios           Usuario[]
  empresas           Empresa[]
  anexos             RegistroAnexo[]
  cadastros          CadastroRegistro[]
  logs               AuditLog[]
  cadcpsCampos       CadCpsCampo[]
  cadcpsHistoricos   CadCpsHistorico[]
  registrosGlobais   RegistroGlobal[]
  codigoSequencias   EntidadeCodigoSequencia[]
  modulos            ClienteModulo[]
  preferencias       UsuarioPreferencia[]
  mdpEntities        MdpEntity[]

  @@index([nome])
  @@index([cpf_cnpj])
  @@index([status])
  @@index([ativo])
}

model Usuario {
  id             String        @id @default(cuid())
  cliente_id     String        @db.VarChar(64)
  codigo         Int?
  nome           String?       @db.VarChar(255)
  login          String        @db.VarChar(120)
  email          String?       @db.VarChar(255)
  telefone       String?       @db.VarChar(32)
  senha_hash     String        @db.VarChar(255)
  perfil         UsuarioPerfil @default(OPERADOR)
  acesso_global  Boolean       @default(false)
  ativo          Boolean       @default(true)
  ultimo_acesso  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  cliente      Cliente              @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  permissoes   PermissaoEmpresa[]
  preferencias UsuarioPreferencia[]
  cadcpsHistoricos CadCpsHistorico[]
  auditLogs    AuditLog[]

  @@unique([cliente_id, login])
  @@index([cliente_id, ativo])
  @@index([cliente_id, codigo])
}

model ClienteModulo {
  id         String   @id @default(cuid())
  cliente_id String   @db.VarChar(64)
  modulo     String   @db.VarChar(64)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@unique([cliente_id, modulo])
  @@index([cliente_id, ativo])
}

model Empresa {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  id_global             Int
  codempresa            Int      @default(0)
  razao_social          String   @db.VarChar(255)
  nome_fantasia         String?  @db.VarChar(255)
  tipo_pessoa           String   @default("PJ") @db.VarChar(4)
  tipo_vinculo          String?  @db.VarChar(32)
  cpf_cnpj              String?  @db.VarChar(32)
  inscricao_estadual    String?  @db.VarChar(64)
  telefone              String?  @db.VarChar(32)
  whatsapp              String?  @db.VarChar(32)
  email                 String?  @db.VarChar(255)
  logo_url              String?  @db.VarChar(2048)
  cep                   String?  @db.VarChar(16)
  endereco              String?  @db.VarChar(255)
  numero                String?  @db.VarChar(32)
  bairro                String?  @db.VarChar(255)
  cidade                String?  @db.VarChar(255)
  estado                String?  @db.VarChar(8)
  observacoes           String?
  status                String   @default("Ativa") @db.VarChar(32)
  campos_personalizados Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente        Cliente              @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  anexos         RegistroAnexo[]
  permissoes     PermissaoEmpresa[]
  cadcpsEmpresas CadCpsCampoEmpresa[]
  cadastros      CadastroRegistro[]
  auditLogs      AuditLog[]

  @@unique([cliente_id, codempresa])
  @@unique([cliente_id, id_global])
  @@index([cliente_id, codempresa])
  @@index([cliente_id, razao_social])
  @@index([cliente_id, nome_fantasia])
  @@index([cliente_id, cpf_cnpj])
  @@index([cliente_id, cidade])
  @@index([cliente_id, estado])
  @@index([cliente_id, status])
  @@index([cliente_id, tipo_pessoa])
  @@index([cliente_id, tipo_vinculo])
  @@index([cliente_id, status, codempresa])
  @@index([cliente_id, updatedAt])
  @@index([razao_social])
  @@index([cpf_cnpj])
}

model CadCpsTela {
  id          String   @id @default(cuid())
  codigo      String   @unique @db.VarChar(64)
  nome        String   @db.VarChar(128)
  entity_name String   @unique @db.VarChar(128)
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campos CadCpsCampoTela[]

  @@index([ativo, ordem])
}

model CadCpsCampo {
  id                  String   @id @default(cuid())
  cliente_id          String   @db.VarChar(64)
  id_global           Int
  codigo              Int
  nome                String   @db.VarChar(255)
  field_name          String   @db.VarChar(128)
  descricao           String?
  tipo                String   @db.VarChar(64)
  ativo               Boolean  @default(true)
  obrigatorio         Boolean  @default(false)
  read_only           Boolean  @default(false)
  visivel_form        Boolean  @default(true)
  visivel_tabela      Boolean  @default(false)
  visivel_relatorio   Boolean  @default(false)
  pesquisavel         Boolean  @default(true)
  filtravel           Boolean  @default(true)
  exportavel          Boolean  @default(true)
  auditavel           Boolean  @default(true)
  aplicacao_modo      String   @default("todas") @db.VarChar(32)
  placeholder         String?  @db.VarChar(255)
  formula             String?
  calculation_builder Json?
  usar_mascara        Boolean  @default(false)
  mascaras_text       String?
  usar_decimal        Boolean  @default(false)
  decimal_places      Int      @default(2)
  separador_decimal   String   @default(",") @db.VarChar(8)
  separador_milhar    String   @default(".") @db.VarChar(8)
  ordem_tabela        Int      @default(999)
  largura_coluna      Int      @default(160)
  relation_entity     String?  @db.VarChar(128)
  options_label_field String?  @db.VarChar(128)
  options_value_field String?  @db.VarChar(128)
  legacy_campo_id     String?  @db.VarChar(64)
  created_by          String?  @db.VarChar(64)
  updated_by          String?  @db.VarChar(64)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cliente   Cliente              @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  telas     CadCpsCampoTela[]
  empresas  CadCpsCampoEmpresa[]
  opcoes    CadCpsCampoOpcao[]
  historico CadCpsHistorico[]

  @@unique([cliente_id, codigo])
  @@unique([cliente_id, field_name])
  @@unique([cliente_id, id_global])
  @@index([cliente_id, ativo])
  @@index([cliente_id, tipo])
  @@index([cliente_id, aplicacao_modo])
  @@index([cliente_id, nome])
  @@index([cliente_id, field_name])
  @@index([cliente_id, codigo])
}

model CadCpsCampoTela {
  campo_id String @db.VarChar(64)
  tela_id  String @db.VarChar(64)

  campo CadCpsCampo @relation(fields: [campo_id], references: [id], onDelete: Cascade)
  tela  CadCpsTela  @relation(fields: [tela_id], references: [id], onDelete: Cascade)

  @@id([campo_id, tela_id])
  @@index([tela_id])
}

model CadCpsCampoEmpresa {
  campo_id   String @db.VarChar(64)
  empresa_id String @db.VarChar(64)

  campo   CadCpsCampo @relation(fields: [campo_id], references: [id], onDelete: Cascade)
  empresa Empresa     @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@id([campo_id, empresa_id])
  @@index([empresa_id])
}

model CadCpsCampoOpcao {
  id        String   @id @default(cuid())
  campo_id  String   @db.VarChar(64)
  codigo    String   @db.VarChar(64)
  descricao String   @db.VarChar(255)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campo CadCpsCampo @relation(fields: [campo_id], references: [id], onDelete: Cascade)

  @@unique([campo_id, codigo])
  @@index([campo_id, ordem])
}

model CadCpsHistorico {
  id             String   @id @default(cuid())
  cliente_id     String   @db.VarChar(64)
  campo_id       String   @db.VarChar(64)
  usuario_id     String?  @db.VarChar(64)
  acao           String   @db.VarChar(64)
  valor_anterior Json?
  valor_novo     Json?
  createdAt      DateTime @default(now())

  cliente Cliente    @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  campo   CadCpsCampo @relation(fields: [campo_id], references: [id], onDelete: Cascade)
  usuario Usuario?    @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([cliente_id, campo_id, createdAt])
  @@index([campo_id, createdAt])
  @@index([usuario_id, createdAt])
}

model EntidadeCodigoSequencia {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  entity_name String   @db.VarChar(128)
  next_codigo Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@unique([cliente_id, entity_name])
  @@index([cliente_id])
}

model CadastroRegistro {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  id_global             Int
  codigo                Int
  empresa_id            String   @db.VarChar(64)
  codempresa            Int
  nome_empresa          String   @db.VarChar(255)
  entity_name           String   @db.VarChar(128)
  nome                  String   @db.VarChar(255)
  status                String   @default("Ativo") @db.VarChar(32)
  observacoes           String?
  campos_personalizados Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, entity_name, codigo])
  @@unique([cliente_id, id_global])
  @@index([cliente_id, entity_name, createdAt])
  @@index([cliente_id, empresa_id, entity_name, createdAt])
  @@index([cliente_id, entity_name, nome])
  @@index([cliente_id, codigo])
  @@index([cliente_id, status])
  @@index([entity_name, status])
}

model RegistroAnexo {
  id              String   @id @default(cuid())
  cliente_id      String   @db.VarChar(64)
  id_global       Int
  entity_name     String   @db.VarChar(128)
  record_id       String?  @db.VarChar(128)
  empresa_id      String?  @db.VarChar(64)
  codempresa      Int?
  nome_empresa    String?  @db.VarChar(255)
  attachment_name String?  @db.VarChar(255)
  file_name       String   @db.VarChar(255)
  file_url        String   @db.VarChar(4096)
  storage_path    String?  @db.VarChar(4096)
  file_type       String?  @db.VarChar(255)
  file_size       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cliente Cliente  @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  empresa Empresa? @relation(fields: [empresa_id], references: [id], onDelete: SetNull)

  @@unique([cliente_id, id_global])
  @@index([cliente_id, entity_name, record_id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, createdAt])
  @@index([entity_name, record_id])
  @@index([empresa_id])
}

model PermissaoEmpresa {
  usuario_id String
  empresa_id String
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, empresa_id])
  @@index([empresa_id])
  @@index([usuario_id])
}

model RegistroGlobal {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  id_global   Int
  entity_name String   @db.VarChar(128)
  registro_id String   @db.VarChar(128)
  createdAt   DateTime @default(now())

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@unique([cliente_id, id_global])
  @@index([cliente_id, entity_name])
  @@index([cliente_id, registro_id])
  @@map("registro_global")
}

model AuditLog {
  id           String   @id @default(cuid())
  cliente_id   String?  @db.VarChar(64)
  id_global    Int?
  usuario_id   String?  @db.VarChar(64)
  empresa_id   String?  @db.VarChar(64)
  codempresa   Int?
  nome_empresa String?  @db.VarChar(255)
  entity_name  String   @db.VarChar(120)
  entity_id    String?  @db.VarChar(120)
  action       String   @db.VarChar(40)
  payload      Json?
  createdAt    DateTime @default(now())

  cliente Cliente? @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  empresa Empresa? @relation(fields: [empresa_id], references: [id], onDelete: SetNull)

  @@index([cliente_id, id_global])
  @@index([cliente_id, createdAt])
  @@index([usuario_id, createdAt])
  @@index([empresa_id, createdAt])
  @@index([entity_name, entity_id, createdAt])
  @@index([action, createdAt])
}

model UsuarioPreferencia {
  id         String   @id @default(cuid())
  usuario_id String   @db.VarChar(64)
  cliente_id String   @db.VarChar(64)
  screen_key String   @db.VarChar(128)
  config     Json
  modulo     String   @default("legacy") @db.VarChar(64)
  tela       String   @default("legacy") @db.VarChar(64)
  versao_schema Int   @default(1)
  preferencias_json Json @default(dbgenerated("'{}'::jsonb"))
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, screen_key])
  @@unique([cliente_id, usuario_id, modulo, tela])
  @@index([cliente_id, usuario_id])
}

// --- MAK DATA PLATFORM (MDP-1) — Entity Dictionary ---

enum MdpScope {
  platform
  tenant
}

enum MdpEntityKind {
  business
  meta
  system
  certification
}

enum MdpEntityLifecycle {
  draft
  active
  deprecated
  archived
}

enum MdpOriginKind {
  platform
  tenant
  marketplace
}

enum MdpEmpresaScope {
  none
  optional
  required
}

enum MdpDefinitionVersionStatus {
  draft
  published
  archived
  rolled_back
}

enum MdpClientTarget {
  web
  mobile
  desktop
  all
}

model MdpDefinitionVersion {
  id                String                     @id @default(cuid())
  cliente_id        String?                    @db.VarChar(64)
  module_id         String?                    @db.VarChar(64)
  semver            String                     @db.VarChar(32)
  revision          Int                        @default(1)
  status            MdpDefinitionVersionStatus @default(published)
  published_at      DateTime?
  published_by      String?                    @db.VarChar(64)
  parent_version_id String?                    @db.VarChar(64)
  changelog         String?
  created_at        DateTime                   @default(now())
  updated_at        DateTime                   @updatedAt

  entities MdpEntity[]

  @@index([cliente_id, module_id, status])
  @@map("mdp_definition_version")
}

model MdpEntity {
  id                      String             @id @default(cuid())
  entity_id               String             @db.VarChar(128)
  module_id               String             @db.VarChar(64)
  codigo                  String             @db.VarChar(64)
  scope                   MdpScope           @default(platform)
  cliente_id              String?            @db.VarChar(64)
  entity_kind             MdpEntityKind      @default(business)
  sort_order              Int                @default(0)
  icon_key                String?            @db.VarChar(64)
  extends_entity_id       String?            @db.VarChar(128)
  origin_kind             MdpOriginKind      @default(platform)
  origin_ref              String?            @db.VarChar(128)
  is_runtime_module       Boolean            @default(true)
  legacy_entity_name      String?            @db.VarChar(128)
  permission_resource_key String?            @db.VarChar(128)
  base_template_id        String             @default("modelobase1") @db.VarChar(64)
  empresa_scope           MdpEmpresaScope    @default(none)
  lifecycle               MdpEntityLifecycle @default(active)
  version_id              String             @db.VarChar(64)
  persistence             Json
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt
  created_by              String?            @db.VarChar(64)
  updated_by              String?            @db.VarChar(64)

  version      MdpDefinitionVersion  @relation(fields: [version_id], references: [id], onDelete: Restrict)
  cliente      Cliente?              @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  labels       MdpEntityLabel[]
  capabilities MdpEntityCapability?
  routes       MdpEntityRoute[]
  audits       MdpEntityAudit[]

  @@unique([scope, entity_id, cliente_id])
  @@index([cliente_id, module_id, lifecycle])
  @@index([module_id, lifecycle])
  @@map("mdp_entity")
}

model MdpEntityLabel {
  id          String   @id @default(cuid())
  entity_id   String   @db.VarChar(64)
  locale      String   @db.VarChar(16)
  singular    String   @db.VarChar(255)
  plural      String   @db.VarChar(255)
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  entity MdpEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@unique([entity_id, locale])
  @@index([locale])
  @@map("mdp_entity_label")
}

model MdpEntityCapability {
  entity_id     String  @id @db.VarChar(64)
  layout        Boolean @default(true)
  field         Boolean @default(true)
  validation    Boolean @default(true)
  formula       Boolean @default(true)
  events        Boolean @default(true)
  actions       Boolean @default(true)
  workflow      Boolean @default(true)
  custom_fields Boolean @default(true)
  attachments   Boolean @default(true)

  entity MdpEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@map("mdp_entity_capability")
}

model MdpEntityRoute {
  id               String          @id @default(cuid())
  entity_id        String          @db.VarChar(64)
  route_path       String          @db.VarChar(255)
  page_code        String?         @db.VarChar(64)
  client_target    MdpClientTarget @default(all)
  menu_section     String?         @db.VarChar(128)
  sort_order       Int             @default(0)
  target_entity_id String?         @db.VarChar(128)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  entity MdpEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@index([entity_id, sort_order])
  @@map("mdp_entity_route")
}

model MdpEntityAudit {
  id         String   @id @default(cuid())
  entity_id  String   @db.VarChar(64)
  action     String   @db.VarChar(64)
  before     Json?
  after      Json?
  usuario_id String?  @db.VarChar(64)
  created_at DateTime @default(now())

  entity MdpEntity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@index([entity_id, created_at])
  @@map("mdp_entity_audit")
}
